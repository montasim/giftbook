{
  "name": "upohar-khata",
  "description": "উপহারের খাতা — পরিবারের উপহারের হিসাব, গুগল শিটে।",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev -- vite dev --port 3100",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:prod": "infisical run --env=prod -- vite build",
    "deploy": "pnpm build:prod && npx -y netlify-cli@27.12.0 deploy --prod --no-build --dir dist/client",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/test/*.test.ts",
    "dev:mock": "vite dev --mode mock --port 3101"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.2.5",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-form": "^1.27.9",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.39",
    "@types/gapi": "^0.0.47",
    "@types/google.accounts": "^0.0.17",
    "@types/google.picker": "^0.0.50",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react": "^7.37.5",
    "fake-indexeddb": "^6.2.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.3",
    "typescript": "^6.0.2",
    "vite": "^8",
    "workbox-build": "7.4.1"
  }
}