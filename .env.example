# উপহারের খাতা — environment variables
# উৎস: Infisical প্রজেক্ট "giftbook" (.infisical.json → workspaceId), env: dev / staging / prod।
#   pnpm dev        → infisical run --env=dev   (লগইন: infisical login)
#   pnpm build:prod → infisical run --env=prod
#   Netlify remote build → netlify.toml (machine identity: INFISICAL_UNIVERSAL_AUTH_CLIENT_ID/SECRET + INFISICAL_PROJECT_ID)
# লোকাল .env ঐচ্ছিক (Infisical ছাড়া চালাতে): cp .env.example .env — Vite .env পড়ে, infisical run-এর মান তার উপরে বসে।
# Infisical-এর key-গুলো নিচের তালিকার সাথে মিলতে হবে।
# সব ভেরিয়েবল src/config/env.ts-এ Zod দিয়ে পড়া হয়। VITE_ prefix = ব্রাউজারে যায় (public)।

# ── Google (docs/PLAN.md §২ "ফেজ ০ — Google Cloud") ───────────────────────────

# OAuth 2.0 Client ID (type: Web). Authorized JS origins-এ http://localhost:3100 + প্রোড ডোমেইন।
# ব্যবহার: GIS token client (scope: drive.file) — src/features/google/real/auth.ts
VITE_GOOGLE_CLIENT_ID=

# API Key — শুধু Google Picker API-তে সীমাবদ্ধ, HTTP referrer দিয়ে ডোমেইনে সীমাবদ্ধ।
# ব্যবহার: Picker setDeveloperKey — src/features/google/real/picker.ts
VITE_GOOGLE_API_KEY=

# Google Cloud project NUMBER (ID নয়)। Picker setAppId — এটা ভুল হলে drive.file অনুমতি নিঃশব্দে মেলে না।
# ব্যবহার: src/features/google/real/picker.ts
VITE_GOOGLE_APP_ID=

# ── সাইট ─────────────────────────────────────────────────────────────────────

# প্রোডাকশন origin (https://..., শেষে / ছাড়া)। সোশ্যাল প্রিভিউর og:url / og:image / canonical absolute করতে লাগে —
# ফাঁকা থাকলে root-relative (/og-v1.png) যায়, যা মেসেজিং অ্যাপের ক্রলার নেয় না। বিল্ডের সময় সেট করো (Netlify env)।
# ব্যবহার: src/config/site.ts → src/routes/__root.tsx
VITE_SITE_URL=

# ── মোড ──────────────────────────────────────────────────────────────────────

# 1 = Google-এর জায়গায় localStorage মক (অ্যাকাউন্ট চুজার, Drive, Picker, Sheets) — credential ছাড়াই পুরো অ্যাপ চলে।
# ফাঁকা/অন্য কিছু = আসল Google। (VITE_GOOGLE_CLIENT_ID ফাঁকা থাকলেও মক চলে।)
# ব্যবহার: src/features/google/index.ts
VITE_GOOGLE_MOCK=1

# ── Vite built-in (সেট করতে হয় না, তথ্যের জন্য) ───────────────────────────────
# import.meta.env.DEV  — dev সার্ভারে true; সেটিংসে সিঙ্ক-সিমুলেশন/নমুনা ডাটা/রিসেট দেখায় (src/routes/_app/settings.tsx)
# import.meta.env.MODE — "development" | "production"
